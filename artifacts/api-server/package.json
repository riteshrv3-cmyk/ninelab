{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:pdf": "node ./test/pdf-parseback.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/express": "^2.1.17",
    "@clerk/shared": "^4.12.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/resume-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "http-proxy-middleware": "^4.0.0",
    "pino": "^9",
    "pino-http": "^10",
    "puppeteer-core": "^25.12.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pdfjs-dist": "^6.1.200",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.7"
  }
}
